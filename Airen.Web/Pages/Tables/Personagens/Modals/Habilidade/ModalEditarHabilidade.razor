@inject HabilidadesAPI habilidadesApi
@inject ISnackbar snackbar

<MudDialog Class="editor-dialog character-dialog">
    <DialogContent>
        <div class="volume-editor character-editor">
            <header class="editor-header">
                <div>
                    <MudText Typo="Typo.h4" Class="editor-title">Editar habilidade</MudText>
                    <MudText Typo="Typo.body2" Class="editor-description">
                        Atualize as informações da habilidade.
                    </MudText>
                </div>
            </header>

            <EditForm Model="@formulario" OnValidSubmit="Salvar">
                <DataAnnotationsValidator />

                <section class="editor-section related-fields">
                    <MudTextField T="string"
                                  @bind-Value="formulario.Nome"
                                  Label="Nome"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => formulario.Nome)" />
                    <div class="text-correction-field">
                        <MudTextField T="string"
                                      @bind-Value="formulario.Descricao"
                                      Label="Descrição"
                                      Variant="Variant.Outlined"
                                      Lines="4" />
                        <TextCorrectionButton @bind-Text="formulario.Descricao" />
                    </div>
                </section>

                <footer class="editor-footer">
                    <MudButton Variant="Variant.Text" OnClick="Cancelar">Cancelar</MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isSaving"
                               StartIcon="@Icons.Material.Outlined.Save">
                        @(isSaving ? "Salvando..." : "Salvar habilidade")
                    </MudButton>
                </footer>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? ModalDialog { get; set; }

    [Parameter]
    public ReadHabilidadeDto? habilidade { get; set; }

    [Parameter]
    public int PotentiaId { get; set; }

    private UpdateHabilidadeDto formulario = new();
    private bool isSaving;

    protected override void OnParametersSet()
    {
        var habilidadeAtual = habilidade
            ?? throw new InvalidOperationException("É necessário informar a habilidade para edição.");

        formulario = new UpdateHabilidadeDto
        {
            Nome = habilidadeAtual.Nome,
            Descricao = habilidadeAtual.Descricao,
            IdPotentia = PotentiaId
        };
    }

    private async Task Salvar()
    {
        var habilidadeAtual = habilidade
            ?? throw new InvalidOperationException("É necessário informar a habilidade para edição.");

        isSaving = true;
        try
        {
            await habilidadesApi.PutHabilidadesAsync(habilidadeAtual, formulario);
            ModalDialog?.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException)
        {
            snackbar.Add("Não foi possível salvar a habilidade. Verifique os dados e tente novamente.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar() => ModalDialog?.Cancel();
}
