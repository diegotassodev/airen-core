@inject PersonagensAPI api
@inject ISnackbar snackbar

<MudDialog Class="editor-dialog character-dialog">
    <DialogContent>
        <div class="volume-editor character-editor">
            <header class="editor-header">
                <div>
                    <MudText Typo="Typo.h4" Class="editor-title">Editar personagem</MudText>
                    <MudText Typo="Typo.body2" Class="editor-description">
                        Atualize as informações do registro.
                    </MudText>
                </div>
            </header>

            <EditForm Model="@formulario" OnValidSubmit="Salvar">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <section class="editor-section">
                    <div class="character-edit-fields">
                        <MudTextField T="string"
                                      @bind-Value="formulario.Nome"
                                      Label="Nome"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      For="@(() => formulario.Nome)"
                                      FullWidth="true" />
                        <MudTextField T="string"
                                      @bind-Value="formulario.NomeOriginal"
                                      Label="Nome original"
                                      Variant="Variant.Outlined"
                                      For="@(() => formulario.NomeOriginal)"
                                      FullWidth="true" />
                        <MudDatePicker @bind-Date="formulario.DataNascimento"
                                       Label="Data de nascimento"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       PickerVariant="PickerVariant.Dialog"
                                       Required="true" />
                        <MudCheckBox T="bool"
                                     @bind-Value="formulario.EstaVivo"
                                     Color="Color.Primary"
                                     Label="Personagem vivo" />
                        <MudTextField T="string"
                                      @bind-Value="formulario.Biografia"
                                      Label="Biografia"
                                      Variant="Variant.Outlined"
                                      Lines="6"
                                      Required="true"
                                      For="@(() => formulario.Biografia)"
                                      FullWidth="true" />
                    </div>
                </section>

                <footer class="editor-footer">
                    <MudButton Variant="Variant.Text" OnClick="Cancelar">
                        Cancelar
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isSaving"
                               StartIcon="@Icons.Material.Outlined.Save">
                        @(isSaving ? "Salvando..." : "Salvar personagem")
                    </MudButton>
                </footer>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? ModalDialog { get; set; }

    [Parameter]
    public ReadPersonagemDto? personagem { get; set; }

    private UpdatePersonagemDto formulario = new();
    private bool isSaving;

    protected override void OnParametersSet()
    {
        var personagemAtual = personagem
            ?? throw new InvalidOperationException("É necessário informar o personagem para edição.");

        formulario = new UpdatePersonagemDto
        {
            Nome = personagemAtual.Nome,
            NomeOriginal = personagemAtual.NomeOriginal,
            Biografia = personagemAtual.Biografia,
            DataNascimento = personagemAtual.DataNascimento,
            EstaVivo = personagemAtual.EstaVivo
        };
    }

    private async Task Salvar()
    {
        var personagemAtual = personagem
            ?? throw new InvalidOperationException("É necessário informar o personagem para edição.");

        isSaving = true;
        try
        {
            await api.PutPersonagensAsync(personagemAtual, formulario);
            ModalDialog?.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException)
        {
            snackbar.Add("Não foi possível salvar o personagem. Verifique os dados e tente novamente.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar() => ModalDialog?.Cancel();
}
