@inject PotentiasAPI potentiasApi
@inject ISnackbar snackbar

<MudDialog Class="editor-dialog character-dialog">
    <DialogContent>
        <div class="volume-editor character-editor">
            <header class="editor-header">
                <div>
                    <MudText Typo="Typo.h4" Class="editor-title">Adicionar potentia</MudText>
                    <MudText Typo="Typo.body2" Class="editor-description">
                        Cadastre a potentia deste personagem.
                    </MudText>
                </div>
            </header>

            <EditForm Model="@potentia" OnValidSubmit="Salvar">
                <DataAnnotationsValidator />

                <section class="editor-section related-fields">
                    <MudTextField T="string"
                                  @bind-Value="potentia.Nome"
                                  Label="Nome"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  For="@(() => potentia.Nome)" />
                    <MudTextField T="string"
                                  @bind-Value="potentia.LinkMusica"
                                  Label="Link da música"
                                  Variant="Variant.Outlined" />
                    <div class="text-correction-field">
                        <MudTextField T="string"
                                      @bind-Value="potentia.Descricao"
                                      Label="Descrição"
                                      Variant="Variant.Outlined"
                                      Lines="4"
                                      Required="true"
                                      For="@(() => potentia.Descricao)" />
                        <TextCorrectionButton @bind-Text="potentia.Descricao" />
                    </div>
                </section>

                <footer class="editor-footer">
                    <MudButton Variant="Variant.Text" OnClick="Cancelar">Cancelar</MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@isSaving"
                               StartIcon="@Icons.Material.Outlined.Add">
                        @(isSaving ? "Salvando..." : "Adicionar potentia")
                    </MudButton>
                </footer>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance? ModalDialog { get; set; }

    [Parameter]
    public int PersonagemId { get; set; }

    private readonly CreatePotentiaDto potentia = new();
    private bool isSaving;

    protected override void OnParametersSet()
    {
        potentia.PersonagemId = PersonagemId;
    }

    private async Task Salvar()
    {
        isSaving = true;
        try
        {
            await potentiasApi.PostPotentiasAsync(potentia);
            ModalDialog?.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException)
        {
            snackbar.Add("Não foi possível salvar a potentia. Verifique os dados e tente novamente.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar() => ModalDialog?.Cancel();
}
