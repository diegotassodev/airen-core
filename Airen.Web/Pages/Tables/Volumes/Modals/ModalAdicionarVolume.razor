@inject VolumesAPI api
@inject NavigationManager NavigationManager

<MudDialog Class = "creator-dialog">
    <DialogContent>
        <div class="volume-creator">
            <header class="creator-header">

                <div>
                    <MudText Typo="Typo.h4" Class="creator-title"> Adicionar Volume </MudText>
                    <MudText Typo="Typo.body2" Class="creator-description">
                        Preencha as informações e o conteúdo descritivo deste volume.
                    </MudText>
                </div>

            </header>

            <EditForm Model="@volume" 
                OnValidSubmit="Criar">
                <DataAnnotationsValidator/>
                <section class="editor-section">
                    <div class="section-heading">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                        <div>
                            <MudText Typo="Typo.subtitle1"> Informações principais </MudText>
                            <MudText Typo="Typo.caption"> Dados básicos utilizados na identificação do volume. </MudText>
                        </div>
                    </div>

                    <div class="fields-grid">
                        <MudTextField @bind-Value="volume!.Numero"
                                    Label="Número"
                                    Variant="Variant.Outlined"
                                    Class="volume-field"
                                    FullWidth="true" />

                        <MudTextField @bind-Value="volume!.Nome"
                                    Label="Nome"
                                    Class="volume-field"
                                    Variant="Variant.Outlined"
                                    FullWidth="true" />

                    </div>

                    <MudTextField @bind-Value="volume!.MensagemVolume"
                            Label="Mensagem"
                            Variant="Variant.Outlined"
                            FullWidth="true"
                            Lines="8"
                            TextArea="true"
                            Class="message-field" />

                    <MudDatePicker @bind-Date="volume!.DataLancamento"
                                    Label="Data de Lançamento"
                                    Variant="Variant.Outlined"
                                    Color="Color.Primary"
                                    DateFormat="dd/MM/yyyy" 
                                    PickerVariant="PickerVariant.Dialog"/>

                </section>

<section class="creator-section">
    <div class="section-heading">
        <MudIcon Icon="@Icons.Material.Outlined.Image"
                 Size="Size.Small" />
        <div>
            <MudText Typo="Typo.subtitle1">
                Capa
            </MudText>

            <MudText Typo="Typo.caption">
                Informe o endereço da imagem utilizada como capa do volume.
            </MudText>
        </div>
    </div>


    <div class="cover-card">
        <div class="cover-preview">
            @if (!string.IsNullOrWhiteSpace(volume?.UrlCapa))
            {
                <img src="@volume.UrlCapa"
                     alt="Capa do volume @volume?.Numero" />
            }
            else
            {
                <div class="cover-placeholder">
                    <MudIcon Icon="@Icons.Material.Outlined.Image"
                             Size="Size.Large" />
                    <MudText Typo="Typo.body2">
                        Sem capa
                    </MudText>
                </div>
            }

        </div>
        <div class="cover-information">

            <MudTextField @bind-Value="volume!.UrlCapa"
                          Label="URL da capa"
                          Placeholder="https://exemplo.com/capa.jpg"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Link" />

            <MudText Typo="Typo.caption" Align="Align.Center">
                Cole o link direto para a imagem da capa.
            </MudText>

            @if (!string.IsNullOrWhiteSpace(volume?.UrlCapa))
            {
                <MudButton Href="@volume.UrlCapa"
                           Target="_blank"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.OpenInNew">
                    Visualizar imagem
                </MudButton>
            }

        </div>

    </div>

</section>
                <footer class="creator-footer">
                    <MudButton Variant="Variant.Text"
                               OnClick="Cancelar">
                        Cancelar
                    </MudButton>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               Disabled="@IsSaving"
                               StartIcon="@Icons.Material.Outlined.Save">

                        @if (IsSaving)
                        {
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <span>Salvar alterações</span>
                        }

                    </MudButton>
                </footer>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@code {

    private bool IsSaving;

    [CascadingParameter]
    public IMudDialogInstance? ModalDialog { get; set; }

    public CreateVolumeDto? volume = new()
    {
        Numero = 0,
        Nome = string.Empty,
        DataLancamento = DateTime.Now,
        MensagemVolume = string.Empty,
        UrlCapa = string.Empty
    };

    private async Task Criar()
    {
        IsSaving = true;
        try
        {
            var createVolume = new CreateVolumeDto
            {
                Numero = volume!.Numero,
                Nome = volume.Nome,
                DataLancamento = volume.DataLancamento,
                MensagemVolume = volume.MensagemVolume,
                UrlCapa = volume.UrlCapa
            };

            await api.PostVolumesAsync(createVolume);
            ModalDialog?.Close(DialogResult.Ok(true));

            NavigationManager.NavigateTo(
                "/volumes",
                replace: true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void Cancelar()
    {
        ModalDialog?.Cancel();
    }

}
