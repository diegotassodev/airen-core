@using System.Globalization
@using Airen.Web.Pages.Tables.Volumes.Modals.Volume
@inject IDialogService dialogService
@inject VolumesAPI VolumesAPI
@inject ISnackbar snackbar

<MudDialog Class="volume-dialog character-dialog character-detail-dialog">

    <TitleContent>
        <div class="volume-header">
            <div class="volume-header-content">
                <span class="volume-label">
                    VOLUME @volume?.Numero
                </span>

                <MudText Class="volume-title">
                    @volume?.Nome
                </MudText>

                <div class="volume-divider"></div>

                <MudText Class="volume-message">
                    @volume?.MensagemVolume
                </MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="document">

            @if (!string.IsNullOrWhiteSpace(volume?.UrlCapa))
            {
                <div class="cover-container">
                    <MudImage Src="@volume.UrlCapa"
                              Alt="@($"Capa do volume {volume.Nome}")"
                              Class="volume-cover" />
                </div>
            }

            <div class="metadata">
                <div class="metadata-item">
                    <span class="metadata-label">PUBLICAÇÃO</span>
                    <span class="metadata-value">
                        @(volume?.DataLancamento?.ToString(
                            "d 'de' MMMM 'de' yyyy",
                            new CultureInfo("pt-BR")
                        ))
                    </span>
                </div>

                <div class="metadata-item">
                    <span class="metadata-label">NÚMERO DE CAPÍTULOS</span>
                    <span class="metadata-value">
                        @(volume?.Capitulos?.Count() ?? 0)
                    </span>
                </div>
            </div>

            <section class="chapters">
                <div class="section-heading">
                    <MudText Class="section-title">Capítulos</MudText>
                </div>

                @if (volume?.Capitulos?.Count > 0)
                {
                    <div class="chapter-list">
                        @foreach (var capitulo in volume.Capitulos)
                        {
                            <article class="chapter">
                                <div class="chapter-number">
                                    @capitulo.Numero.ToString("00")
                                </div>
                                <div class="chapter-content">
                                    <MudText Class="chapter-title">
                                        @capitulo.Titulo
                                    </MudText>
                                    <MudText Class="chapter-summary">
                                        @capitulo.Resumo
                                    </MudText>
                                    <div class="chapter-footer">
                                        @capitulo.NumeroPaginas páginas
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="chapter-empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.Article" />
                        <MudText Typo="Typo.body2">Este volume ainda não possui capítulos.</MudText>
                    </div>
                }
            </section>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Outlined.Delete"
                   OnClick="(() => DeleteVolume(volume!))">
            Excluir
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Edit"
                   OnClick="(() => OpenModal(volume!))">
            Editar volume
        </MudButton>
    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    public IMudDialogInstance? ModalDialog { get; set; }

    [Parameter]
    public ReadVolumeDto? volume { get; set; }

    private async Task OpenModal(ReadVolumeDto volumeDto)
    {
        var options = new DialogOptions {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var parameters = new DialogParameters<ModalEditarVolume>
        {
            {"volume", volumeDto}
        };

        var dialog = await dialogService.ShowAsync<ModalEditarVolume>(parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            ModalDialog?.Close(DialogResult.Ok(true));
    }

    private async Task DeleteVolume(ReadVolumeDto volumeDto)
    {
        bool? result = await dialogService.ShowMessageBoxAsync(
            "Confirmar Exclusão",
            "Tem certeza que deseja excluir este volume?",
            "Sim",
            "Não"
        );

        if (result == true)
        {
            try
            {
                await VolumesAPI.DeleteVolumesAsync(volumeDto);
                ModalDialog?.Close(DialogResult.Ok(true));
                snackbar.Add("Volume excluído com sucesso.", Severity.Success);
            }
            catch (HttpRequestException)
            {
                snackbar.Add("Não foi possível excluir o volume. Tente novamente.", Severity.Error);
            }
        }
    }
}